# ==============================================================================
# Mentora Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render: Configure these key-value pairs in the Render Web Service Dashboard
# under "Environment Variables".
# ==============================================================================

# Django Secret Key (Generate a secure 50+ character random string for production)
SECRET_KEY=django-insecure-replace-with-a-cryptographically-strong-secret-key-in-production

# Debug Mode (MUST be False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames/IPs)
# Note: On Render, RENDER_EXTERNAL_HOSTNAME is automatically detected and added.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CSRF Trusted Origins (Comma-separated list of schemes + domains)
# Required for Render HTTPS and modern Django form submissions.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (PostgreSQL)
# Local example: postgresql://postgres:password@127.0.0.1:5433/mentora_db
# On Render: Use the Internal Database URL from your Render PostgreSQL instance:
#   postgres://user:password@dpg-xxxx.oregon-postgres.render.com/mentora_db
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/mentora_db

# Google Gemini API Key for Socratic AI Mentoring
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security & HTTPS Settings (Automatically defaults to True in production when DEBUG=False)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Media Storage (Optional: specify path if mounting a Render Persistent Disk)
# Example: MEDIA_ROOT=/var/data/media
# MEDIA_ROOT=media

# Logging Level (Optional: DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO
