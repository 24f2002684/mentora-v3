# ==============================================================================
# Mentora Environment Configuration Example
# Copy this file to .env for local development:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
#
# Production Architecture:
# - Web Service: Render Free Tier
# - Database: Supabase PostgreSQL (Session Pooler IPv4)
# - File Storage: Supabase Storage (S3-Compatible Gateway)
# ==============================================================================

# Django Secret Key (Generate a secure 50+ character random string for production)
SECRET_KEY=django-insecure-replace-with-a-cryptographically-strong-secret-key-in-production

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames/IPs)
# Note: On Render, RENDER_EXTERNAL_HOSTNAME is automatically detected and appended.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CSRF Trusted Origins (Comma-separated list of schemes + domains)
# Required for Render HTTPS and modern Django form submissions.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==============================================================================
# Database Configuration (Supabase PostgreSQL)
# ==============================================================================
# Local Development:
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5433/mentora_db
#
# Supabase Production (Recommended: Session Pooler on Port 5432 - IPv4 compatible):
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Supabase Transaction Pooler (Port 6543):
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/mentora_db

# Connection pooler lifetime (Seconds: 60 for Supabase session pooler, 0 for transaction pooler, 600 for local)
CONN_MAX_AGE=60

# Optional: Disable server-side cursors (automatically enabled if port 6543 is detected)
# DISABLE_SERVER_SIDE_CURSORS=False

# ==============================================================================
# Persistent File Storage (Supabase Storage - S3-Compatible)
# ==============================================================================
# Set to True in production to store user avatars, vision boards, and attachments in Supabase Storage.
# Set to False (or leave blank) in local development to store files in local media/ folder.
USE_SUPABASE_STORAGE=False

# Supabase Project Reference (e.g. abcdefghijklmnop from your Supabase URL)
SUPABASE_PROJECT_REF=your-supabase-project-ref

# S3 Access Keys (Obtain from Supabase Dashboard -> Project Settings -> Storage -> S3 Access Keys)
SUPABASE_STORAGE_ACCESS_KEY_ID=your_supabase_s3_access_key_id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key

# Supabase Storage S3 Endpoint URL:
# Pattern: https://<PROJECT-REF>.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ENDPOINT_URL=https://your-supabase-project-ref.storage.supabase.co/storage/v1/s3

# Bucket name (Create as a PRIVATE bucket in Supabase Storage)
SUPABASE_STORAGE_BUCKET_NAME=mentora-media

# S3 Region (Default: us-east-1 works for all Supabase S3 gateways)
SUPABASE_STORAGE_REGION=us-east-1

# Expiration for presigned media URLs in seconds (default: 3600 = 1 hour)
SUPABASE_STORAGE_URL_EXPIRE=3600

# Local media fallback folder (Used when USE_SUPABASE_STORAGE is False)
# MEDIA_ROOT=media

# ==============================================================================
# AI Integration (Google Gemini API)
# ==============================================================================
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Security & HTTPS Settings
# ==============================================================================
# In production (DEBUG=False), these default to True automatically.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Production Console Logging Level (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO
